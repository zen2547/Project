// Models are added slice by slice — see tasks/todo.md.
// Each task adds only the models it needs, in its own migration.

generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── identity ────────────────────────────────────────────────────────────────

enum Role {
  MEMBER
  ADMIN
}

// Glossary word: Member (or Admin). Code keeps the conventional name `User`.
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique // stored trimmed + lower-cased
  passwordHash String
  displayName  String
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())
}

// ─── catalogue ───────────────────────────────────────────────────────────────

// The chips on a Movie page. The `movies` relation is added with Movie (Task 9).
// Names are trimmed by the API; uniqueness is exact (case-sensitive).
model Genre {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model Keyword {
  id   Int    @id @default(autoincrement())
  name String @unique
}

// Where to watch (Netflix, Disney+ …). Links to Movies arrive in Task 13.
model StreamingService {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  logoUrl String? // https only (checked by the API)
}
