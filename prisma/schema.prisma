// Models are added slice by slice — see tasks/todo.md.
// Each task adds only the models it needs, in its own migration.

generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── identity ────────────────────────────────────────────────────────────────

enum Role {
  MEMBER
  ADMIN
}

// Glossary word: Member (or Admin). Code keeps the conventional name `User`.
model User {
  id           Int             @id @default(autoincrement())
  email        String          @unique // stored trimmed + lower-cased
  passwordHash String
  displayName  String
  role         Role            @default(MEMBER)
  createdAt    DateTime        @default(now())
  watchlist    WatchlistItem[]
  watched      WatchedEntry[]
  reviews      Review[]
}

// ─── catalogue ───────────────────────────────────────────────────────────────

enum Certification {
  G
  PG
  PG_13
  R
  NC_17
  NOT_RATED
}

model Movie {
  id             Int             @id @default(autoincrement())
  title          String
  releaseYear    Int
  certification  Certification   @default(NOT_RATED)
  runtimeMinutes Int?
  synopsis       String?
  posterUrl      String? // https only (checked by the API)
  // Community Rating. Owned by the reviews module (Task 17); never written
  // through the catalogue API.
  ratingAvg      Decimal?        @db.Decimal(3, 1)
  reviewCount    Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  genres         Genre[]
  keywords       Keyword[]
  credits        Credit[]
  trailers       Trailer[]
  photos         Photo[]
  streamingLinks StreamingLink[]
  watchlistedBy  WatchlistItem[]
  watchedBy      WatchedEntry[]
  reviews        Review[]
}

// The chips on a Movie page. Many-to-many with Movie: deleting a Genre or
// Keyword only removes it from Movies, never the Movies themselves.
// Names are trimmed by the API; uniqueness is exact (case-sensitive).
model Genre {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  movies Movie[]
}

model Keyword {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  movies Movie[]
}

// Where to watch (Netflix, Disney+ …).
model StreamingService {
  id      Int             @id @default(autoincrement())
  name    String          @unique
  logoUrl String? // https only (checked by the API)
  links   StreamingLink[]
}

// ─── people & credits ───

enum CreditRole {
  DIRECTOR
  WRITER
  CAST
}

// Anyone in a Movie's cast or crew.
model Person {
  id        Int       @id @default(autoincrement())
  name      String
  bio       String?
  photoUrl  String? // https only (checked by the API)
  birthDate DateTime? @db.Date
  credits   Credit[]

  @@index([name])
}

// One Person's job on one Movie. The same Person can direct AND write the
// same Movie (two Credits), but not hold the same role twice.
model Credit {
  id        Int        @id @default(autoincrement())
  movieId   Int
  personId  Int
  role      CreditRole
  character String? // CAST only
  order     Int        @default(0) // billing order; lowest first
  movie     Movie      @relation(fields: [movieId], references: [id], onDelete: Cascade)
  // Restrict: a Person with Credits can't be deleted (API answers 409).
  person    Person     @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@unique([movieId, personId, role])
  @@index([personId])
}

// ─── movie media ───

model Trailer {
  id         Int    @id @default(autoincrement())
  movieId    Int
  title      String
  youtubeUrl String // youtube.com or youtu.be, https (checked by the API)
  movie      Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId])
}

model Photo {
  id      Int     @id @default(autoincrement())
  movieId Int
  url     String // https only (checked by the API)
  caption String?
  movie   Movie   @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId])
}

// "Watch on Netflix": at most one link per Movie per Streaming Service.
model StreamingLink {
  movieId   Int
  serviceId Int
  url       String // https only (checked by the API)
  movie     Movie            @relation(fields: [movieId], references: [id], onDelete: Cascade)
  service   StreamingService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([movieId, serviceId])
}

// ─── library (SPEC-library.md) ───

// "Add to Watchlist": a Member's private list of Movies to watch later.
model WatchlistItem {
  userId  Int
  movieId Int
  addedAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie   Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@index([userId, addedAt])
}

// "Mark as watched". Independent of the Watchlist: marking a Movie Watched
// does not remove it from the Watchlist. Posting a Review also marks it.
model WatchedEntry {
  userId    Int
  movieId   Int
  watchedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@index([userId, watchedAt])
}

// ─── reviews (SPEC-reviews.md) ───

// One Review per Member per Movie: a Score (1–10) and an optional Comment.
// Every write also updates Movie.ratingAvg / reviewCount in the same
// transaction (docs/adr/0001-denormalized-community-rating.md).
model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  movieId   Int
  score     Int // 1–10 (checked by the API)
  comment   String? // trimmed; "" stored as null; max 2000 chars
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([movieId, createdAt])
  @@index([userId, createdAt])
}
