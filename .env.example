# Copy to .env and fill in. Never commit .env.

PORT=3000

# Local Postgres (same server as dnc03), separate databases for this app
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/imdb_dev
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/imdb_test

# Auth: JWT_SECRET must be at least 32 characters; JWT_EXPIRES_IN is in seconds
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN=3600

# First Admin, created by `pnpm prisma db seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_DISPLAY_NAME=Admin
